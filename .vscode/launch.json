{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Next.js: 开发模式调试",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev"],
      "cwd": "${workspaceFolder}/apps/web",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"],
      "serverReadyAction": {
        "pattern": "- Local:.+(https?://[^ ]+)",
        "uriFormat": "%s",
        "action": "debugWithChrome"
      }
    }
  ]
}

