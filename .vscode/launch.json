{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Vue/Vite: 开发模式调试",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "corepack",
      "runtimeArgs": ["pnpm", "dev"],
      "cwd": "${workspaceFolder}/web",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"],
      "serverReadyAction": {
        "pattern": "Local:\\s+(https?://[^ ]+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    }
  ]
}

