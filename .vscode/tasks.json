{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "前端: 安装依赖",
      "type": "shell",
      "command": "pnpm install",
      "options": {
        "cwd": "${workspaceFolder}/apps/web"
      },
      "problemMatcher": []
    },
    {
      "label": "前端: 启动开发服务器",
      "type": "shell",
      "command": "pnpm dev",
      "options": {
        "cwd": "${workspaceFolder}/apps/web"
      },
      "problemMatcher": []
    },
    {
      "label": "前端: 类型检查",
      "type": "shell",
      "command": "pnpm typecheck",
      "options": {
        "cwd": "${workspaceFolder}/apps/web"
      },
      "group": "test",
      "problemMatcher": "$tsc"
    },
    {
      "label": "前端: 格式检查",
      "type": "shell",
      "command": "pnpm format:check",
      "options": {
        "cwd": "${workspaceFolder}/apps/web"
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "前端: 构建",
      "type": "shell",
      "command": "pnpm build",
      "options": {
        "cwd": "${workspaceFolder}/apps/web"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "项目: 提交并推送前端第一步",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/finish-step1.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}

