{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "前端: 安装依赖",
      "type": "shell",
      "command": "corepack",
      "args": ["pnpm", "install"],
      "options": {
        "cwd": "${workspaceFolder}/web"
      },
      "problemMatcher": []
    },
    {
      "label": "前端: 启动开发服务器",
      "type": "shell",
      "command": "corepack",
      "args": ["pnpm", "dev"],
      "options": {
        "cwd": "${workspaceFolder}/web"
      },
      "problemMatcher": []
    },
    {
      "label": "前端: 类型检查",
      "type": "shell",
      "command": "corepack",
      "args": ["pnpm", "typecheck"],
      "options": {
        "cwd": "${workspaceFolder}/web"
      },
      "group": "test",
      "problemMatcher": "$tsc"
    },
    {
      "label": "前端: 格式检查",
      "type": "shell",
      "command": "corepack",
      "args": ["pnpm", "format:check"],
      "options": {
        "cwd": "${workspaceFolder}/web"
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "前端: 构建",
      "type": "shell",
      "command": "corepack",
      "args": ["pnpm", "build"],
      "options": {
        "cwd": "${workspaceFolder}/web"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "项目: 提交并推送当前前端改动",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/docs/finish-step1.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}

