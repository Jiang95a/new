# 模型（必填）
LLM_PROVIDER=deepseek
LLM_API_KEY=

# 以下留空则使用 app/core/config.py 里 PROVIDER_PRESETS 的默认值
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# 生成参数
LLM_TEMPERATURE=0.3
LLM_TIMEOUT=60
LLM_MAX_TOKENS=2048

# 服务
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=*

# 记忆
HISTORY_LIMIT=20
DB_PATH=data/agent.db
