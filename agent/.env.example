# 模型（必填）
LLM_PROVIDER=deepseek
LLM_API_KEY=

# 以下留空则使用 app/core/config.py 里 PROVIDER_PRESETS 的默认值
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# 生成参数
LLM_TEMPERATURE=0.3
LLM_TIMEOUT=60
LLM_MAX_TOKENS=2048

# 服务
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=*

# 记忆
HISTORY_LIMIT=20

# ---------------------------------------------------------------
# 数据库：sqlite（默认，零依赖）或 mysql（联调/部署）
# 开发期建议保持 sqlite，跑得快；联调时改成 mysql 再重启即可
# ---------------------------------------------------------------
DB_BACKEND=sqlite

# sqlite 专用
DB_PATH=data/agent.db

# mysql 专用（DB_BACKEND=mysql 时才读；库不存在会自动创建）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=campus_agent
