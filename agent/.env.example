# 模型（必填）
LLM_PROVIDER=deepseek
LLM_API_KEY=

# 以下留空则使用 app/core/config.py 里 PROVIDER_PRESETS 的默认值
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# 生成参数
LLM_TEMPERATURE=0.3
LLM_TIMEOUT=60
LLM_MAX_TOKENS=2048

# 服务
HOST=127.0.0.1
PORT=8000
# 上线必须改成具体域名；填 * 时代码会自动关掉 allow_credentials（浏览器不接受通配符带凭证）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 记忆
HISTORY_LIMIT=20

# ---------------------------------------------------------------
# 视觉 / 多模态：海报解析。必须是一个能读图的模型。
# 主模型可以就用 deepseek（便宜、擅长写方案），海报解析单独配一套。
# 三个值都不填 = 没配视觉模型，/poster/extract 会老实返回 503，前端回退手动填写。
# ---------------------------------------------------------------
VISION_MODEL=
# 留空则复用 LLM_API_KEY
VISION_API_KEY=
# 留空则复用 LLM_BASE_URL
VISION_BASE_URL=
VISION_ENABLED=true
VISION_TIMEOUT=90
# 和前端上传限制保持一致（字节）
POSTER_MAX_BYTES=5242880

# ---------------------------------------------------------------
# RAG：本地知识库检索（data/knowledge/*.md）
# 默认 local = 本地哈希向量，零依赖、离线可跑、可复现；
# 想用真 embedding 就改 api，并保证 LLM_API_KEY 能调 embeddings 接口。
# ---------------------------------------------------------------
RAG_ENABLED=true
RAG_TOP_K=4
# 低于这个「内容分」的资料直接丢掉，不喂给模型
RAG_MIN_SCORE=0.20
RAG_CONTEXT_CHARS=1800
EMBEDDING_BACKEND=local
# EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=512

# ---------------------------------------------------------------
# AI 安全护栏
# ---------------------------------------------------------------
GUARD_ENABLED=true
# 单 IP 每分钟最多几次花钱的调用（/chat、/poster/extract）
RATE_LIMIT_PER_MINUTE=40
# 客户端可控的「本次附加要求」最大长度，超了截断
SYSTEM_EXTRA_MAX_CHARS=300

# ---------------------------------------------------------------
# 数据库：sqlite（默认，零依赖）或 mysql（联调/部署）
# 开发期建议保持 sqlite，跑得快；联调时改成 mysql 再重启即可
# ---------------------------------------------------------------
DB_BACKEND=sqlite

# sqlite 专用
DB_PATH=data/agent.db

# mysql 专用（DB_BACKEND=mysql 时才读；库不存在会自动创建）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=campus_agent
