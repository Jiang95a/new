# Copy to .env and replace all placeholder values. Never commit real secrets.
# 中文说明：复制成后端项目的 .env，把所有 replace-me / 占位密码换掉；.env 已在 .gitignore 里

APP_ENV=development
API_BASE_URL=http://localhost:8000/api/v1
PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------- 数据库（MySQL 8）
# 详细步骤见 docs/mysql-快速开始.md
DATABASE_URL=mysql+pymysql://campus_app:Campus_2026@127.0.0.1:3306/campus_diy?charset=utf8mb4

# 不用 DATABASE_URL 的框架可以读这几个
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=campus_diy
DB_USER=campus_app
DB_PASSWORD=Campus_2026
DB_CHARSET=utf8mb4

# 会话/缓存：V1 可以先不启用，用内存实现
# REDIS_URL=redis://127.0.0.1:6379/0

JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# ---------------------------------------------------------------- 图片存储（阿里云 OSS）
# bucket 必须设为「私有读」，前端展示用签名 URL（有效期 5~10 分钟）
# 后端给前端的只有 object_key；调试接口也只接受 object_key，不接受任意 URL（防 SSRF）
OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
OSS_REGION=cn-beijing
OSS_BUCKET=replace-me
OSS_ACCESS_KEY_ID=replace-me
OSS_ACCESS_KEY_SECRET=replace-me

# 旧方案（MinIO / S3），已弃用，留作参考
# S3_ENDPOINT=http://minio:9000
# S3_ACCESS_KEY=minio
# S3_SECRET_KEY=replace-me
# S3_BUCKET=campus-assets

# ---------------------------------------------------------------- 大模型
LLM_PROVIDER=openai-compatible
LLM_API_KEY=replace-me
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
VISION_MODEL=replace-me
AI_MAX_CONCURRENCY_PER_USER=1
AI_JOB_TIMEOUT_SECONDS=60

# AI 服务（agent/）地址：后端调它，不要前端直连
AGENT_BASE_URL=http://127.0.0.1:8000

UPLOAD_MAX_MB=10
SUBMISSION_IDEMPOTENCY_TTL_HOURS=24
EXPORT_URL_TTL_HOURS=24

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_PUBLIC_BASE_URL=http://localhost:3000
